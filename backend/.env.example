# Core Django settings
SECRET_KEY=replace-with-a-long-random-development-secret
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Browser frontend origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=tenantflow_db
DB_USER=tenantflow_user
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
# Keep False for local development without Redis. Set True where a Celery
# worker and Redis broker/result backend are intentionally available.
BACKGROUND_JOBS_ENABLED=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Safe local email output. Replace with SMTP settings only when needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# Production-only security controls (development values)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
